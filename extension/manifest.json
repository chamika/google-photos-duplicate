{
  "manifest_version": 3,
  "name": "Google Photos Duplicate Deleter",
  "version": "1.0.0",
  "description": "Bulk delete duplicate photos from Google Photos using a duplicates.json file generated by the scanner tool.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://photos.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://photos.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png"
  }
}
